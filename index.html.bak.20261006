  </div><!-- /page -->

  <script>
    // Tab 切换
    var tabs = document.querySelectorAll('.tab');
    var panels = document.querySelectorAll('.skill-panel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.remove('active'); });
        panels.forEach(function (p) { p.classList.remove('active'); });
        tab.classList.add('active');
        document.getElementById(tab.dataset.target).classList.add('active');
      });
    });

    // 小卡片点击跳转并激活对应技能 Tab
    document.querySelectorAll('.mini-card[data-skill]').forEach(function (card) {
      card.addEventListener('click', function () {
        var target = card.dataset.skill;
        var tab = document.querySelector('.tab[data-target="' + target + '"]');
        if (!tab) return;
        tabs.forEach(function (t) { t.classList.remove('active'); });
        panels.forEach(function (p) { p.classList.remove('active'); });
        tab.classList.add('active');
        document.getElementById(target).classList.add('active');
      });
    });

    // ===== 交互背景射线 =====
    (function () {
      var canvas = document.getElementById('rays');
      if (!canvas || !canvas.getContext) return;
      var ctx = canvas.getContext('2d');
      var w = 0, h = 0;
      var mx = 0.5, my = 0.5, tmx = 0.5, tmy = 0.5;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function resize() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resize);
      resize();

      window.addEventListener('mousemove', function (e) {
        tmx = e.clientX / w;
        tmy = e.clientY / h;
      });

      function draw(time) {
        ctx.clearRect(0, 0, w, h);
        ctx.lineWidth = 1.3;
        var n = 16;
        var base = 0.72;
        var span = h + base * w;
        for (var i = 0; i < n; i++) {
          var off = (i / (n - 1)) * span - h;
          var amp = 9 + (i % 3) * 6;
          var speed = 0.5 + (i % 4) * 0.16;
          var alpha = 0.026 + (i % 5) * 0.005;
          ctx.strokeStyle = 'rgba(126, 247, 200, ' + alpha.toFixed(3) + ')';
          ctx.beginPath();
          for (var x = -140; x <= w + 140; x += 10) {
            var wave = Math.sin(x * 0.006 + time * speed + i * 0.8 + mx * 5.0) * amp;
            var y = -base * x + off + wave + (my - 0.5) * 50;
            if (x === -140) ctx.moveTo(x, y); else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }
      }

      if (reduced) { draw(0); return; }

      var t0 = performance.now();
      (function loop(now) {
        var time = (now - t0) * 0.001;
        mx += (tmx - mx) * 0.06;
        my += (tmy - my) * 0.06;
        draw(time);
        requestAnimationFrame(loop);
      })(t0);
    })();

    // ===== 光标光晕 =====
    (function () {
      var glow = document.getElementById('cursor-glow');
      if (!glow) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var gx = -1000, gy = -1000, cx = -1000, cy = -1000;
      window.addEventListener('mousemove', function (e) { gx = e.clientX; gy = e.clientY; });
      (function loop() {
        cx += (gx - cx) * 0.14;
        cy += (gy - cy) * 0.14;
        glow.style.transform = 'translate3d(' + cx + 'px, ' + cy + 'px, 0)';
        requestAnimationFrame(loop);
      })();
    })();

    // ===== 首屏插画随鼠标轻微倾斜 =====
    (function () {
      var illustration = document.querySelector('.illustration');
      if (!illustration) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!window.matchMedia('(min-width: 901px)').matches) return;
      var trx = 0, trY = 0, crx = 0, crY = 0;
      illustration.addEventListener('mousemove', function (e) {
        var r = illustration.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width - 0.5;
        var py = (e.clientY - r.top) / r.height - 0.5;
        trY = px * 8;
        trx = -py * 6;
      });
      illustration.addEventListener('mouseleave', function () { trx = 0; trY = 0; });
      (function loop() {
        crx += (trx - crx) * 0.09;
        crY += (trY - crY) * 0.09;
        illustration.style.transform = 'perspective(900px) rotateX(' + crx.toFixed(2) + 'deg) rotateY(' + crY.toFixed(2) + 'deg)';
        requestAnimationFrame(loop);
      })();
    })();
  </script>
</body>
</html>
