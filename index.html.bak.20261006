<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Freya Qian（钱皓）— AI 产品经理 / 大模型产品 / Agent 产品研究">
  <title>钱皓 · Freya Qian — AI 产品经理</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --color-obsidian-shell: #101820;
      --color-pure-white: #F7FAFC;
      --color-mint-frost: #172434;
      --color-deep-abyss: #172434;
      --color-charcoal: #0a1219;
      --color-fog-border: #23384A;
      --color-stone-border: #23384A;
      --color-slate-text: #8b98a5;
      --color-graphite-fill: #23384A;
      --color-pure-black: #000000;
      --color-neon-pulse: #7EF7C8;
      --color-mint-whisper: #7EF7C8;
      --color-signal-yellow: #FFE66D;

      --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, 'PingFang SC', 'Microsoft YaHei', monospace;

      --radius-buttons: 56px;
      --radius-tabs: 56px;
      --radius-cards: 20px;
      --radius-largecards: 60px;
      --radius-smallelements: 10px;

      --shadow-md: rgba(0, 0, 0, 0.04) 1px 0px 9px 2px;
      --page-max-width: 1200px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      font-weight: 400;
      background: var(--color-obsidian-shell);
      color: var(--color-pure-white);
      line-height: 1.5;
      letter-spacing: -0.08px;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ===== 交互背景 & 光晕 ===== */
    #rays {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    #page {
      position: relative;
      z-index: 1;
    }

    #cursor-glow {
      position: fixed;
      top: 0;
      left: 0;
      width: 560px;
      height: 560px;
      margin: -280px 0 0 -280px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(126, 247, 200, .10) 0%, rgba(126, 247, 200, .04) 40%, transparent 70%);
      pointer-events: none;
      z-index: 2;
      mix-blend-mode: screen;
      transform: translate3d(-1000px, -1000px, 0);
    }

    .container { max-width: var(--page-max-width); margin: 0 auto; padding: 0 32px; }

    /* ===== 公告横幅 ===== */
    .announcement {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      background: var(--color-neon-pulse);
      color: var(--color-obsidian-shell);
      font-size: 14px;
      padding: 10px 48px;
      position: relative;
      text-align: center;
    }
    .announcement .banner-close {
      position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--color-obsidian-shell);
      font-size: 18px; cursor: pointer; line-height: 1; padding: 4px;
    }

    /* ===== 导航 ===== */
    .navbar {
      position: sticky; top: 0; z-index: 100;
      background: var(--color-obsidian-shell);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .navbar-inner {
      max-width: var(--page-max-width); margin: 0 auto; padding: 16px 32px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .logo {
      display: flex; align-items: center; gap: 10px;
      font-family: var(--font-mono); font-weight: 500; font-size: 17px;
      color: var(--color-pure-white); text-decoration: none;
    }
    .logo-mark {
      width: 28px; height: 28px; border-radius: 8px; background: var(--color-neon-pulse);
      display: flex; align-items: center; justify-content: center; color: var(--color-obsidian-shell);
    }
    .logo-mark svg { width: 15px; height: 15px; }
    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a { color: var(--color-pure-white); text-decoration: none; font-size: 15px; transition: color .2s; }
    .nav-links a:hover { color: var(--color-neon-pulse); }
    .nav-cta { display: flex; align-items: center; gap: 16px; }
    .nav-cta .signin { color: var(--color-pure-white); text-decoration: none; font-size: 15px; }
    .nav-cta .signin:hover { color: var(--color-neon-pulse); }

    /* ===== 按钮 ===== */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      font-family: var(--font-sans); font-size: 16px; font-weight: 400;
      padding: 14px 28px; border-radius: var(--radius-buttons);
      cursor: pointer; text-decoration: none; transition: all .2s ease;
      border: none; white-space: nowrap;
    }
    .btn-primary { background: var(--color-neon-pulse); color: var(--color-obsidian-shell); }
    .btn-primary:hover { filter: brightness(1.08); }
    .btn-ghost { background: transparent; color: var(--color-pure-white); border: 1.5px solid var(--color-pure-white); }
    .btn-ghost:hover { border-color: var(--color-neon-pulse); color: var(--color-neon-pulse); }

    /* ===== Hero ===== */
    .hero { padding: 96px 0 80px; overflow: hidden; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: center; }
    .eyebrow {
      display: inline-block; font-family: var(--font-mono); font-size: 9px; font-weight: 400;
      letter-spacing: 0.45px; text-transform: uppercase; color: var(--color-neon-pulse); margin-bottom: 24px;
    }
    .hero h1 { font-family: var(--font-mono); font-size: 64px; font-weight: 500; line-height: 1.1; color: var(--color-pure-white); margin-bottom: 24px; }
    .hero h1 .accent { color: var(--color-neon-pulse); }
    .hero .subtitle { font-size: 18px; line-height: 1.45; color: rgba(255,255,255,.72); max-width: 440px; margin-bottom: 24px; }
    .hero-meta { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 36px; }
    .hero-meta span {
      font-family: var(--font-mono); font-size: 12px; color: rgba(255,255,255,.65);
      border: 1px solid rgba(255,255,255,.16); border-radius: 999px; padding: 7px 14px; letter-spacing: .02em;
    }
    .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }

    /* ===== 评测控制台卡片 ===== */
    .illustration { position: relative; min-height: 400px; display: flex; align-items: center; justify-content: center; }
    .hero-glow {
      position: absolute; top: 50%; left: 50%; width: 440px; height: 440px; margin: -220px 0 0 -220px;
      border-radius: 50%; background: radial-gradient(circle, rgba(126,247,200,.16) 0%, rgba(126,247,200,.05) 40%, transparent 70%);
      pointer-events: none;
    }
    .mini-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      width: 450px;
      z-index: 1;
      animation: gridIn 0.7s ease both;
    }

    @keyframes gridIn {
      from { opacity: 0; transform: translateY(22px); }
      to { opacity: 1; transform: none; }
    }

    .mini-card {
      background: var(--color-deep-abyss);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 16px;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      cursor: pointer;
      transition: border-color .25s ease, box-shadow .25s ease;
      animation: cardFloat 4s ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }

    .mini-card:nth-child(1) { --d: 0s; border-color: rgba(126, 247, 200, .42); background: rgba(126, 247, 200, .07); }
    .mini-card:nth-child(2) { --d: .5s; border-color: rgba(255, 230, 109, .42); background: rgba(255, 230, 109, .07); }
    .mini-card:nth-child(3) { --d: 1s; border-color: rgba(244, 169, 43, .42); background: rgba(244, 169, 43, .07); }
    .mini-card:nth-child(4) { --d: 1.5s; border-color: rgba(233, 68, 54, .42); background: rgba(233, 68, 54, .07); }

    .mini-card:nth-child(1):hover { border-color: #7EF7C8; box-shadow: 0 0 0 1px rgba(126, 247, 200, .45), 0 14px 32px rgba(126, 247, 200, .18); }
    .mini-card:nth-child(2):hover { border-color: #FFE66D; box-shadow: 0 0 0 1px rgba(255, 230, 109, .45), 0 14px 32px rgba(255, 230, 109, .18); }
    .mini-card:nth-child(3):hover { border-color: #F4A92B; box-shadow: 0 0 0 1px rgba(244, 169, 43, .45), 0 14px 32px rgba(244, 169, 43, .18); }
    .mini-card:nth-child(4):hover { border-color: #E94436; box-shadow: 0 0 0 1px rgba(233, 68, 54, .45), 0 14px 32px rgba(233, 68, 54, .18); }

    .mini-card .mi {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      image-rendering: pixelated;
      box-shadow: 3px 3px 0 rgba(0,0,0,.35);
      transition: transform .2s ease;
    }

    .mini-card:hover .mi { transform: scale(1.18) rotate(-4deg); }

    .mini-card h4 { font-family: var(--font-mono); font-size: 14px; font-weight: 500; color: var(--color-pure-white); margin-bottom: 4px; }
    .mini-card .val { font-family: var(--font-mono); font-size: 15px; color: var(--color-neon-pulse); }

    @keyframes cardFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    /* ===== 游戏像素元素 ===== */
    .game-ground {
      position: absolute;
      bottom: -92px;
      left: -20px;
      right: -20px;
      height: 8px;
      border-radius: 4px;
      background: rgba(126, 247, 200, .2);
      z-index: 1;
    }

    .game-char { position: absolute; bottom: -84px; left: 6%; z-index: 2; animation: gameJump 1.35s cubic-bezier(.34,.05,.2,1) infinite; }
    .game-block { position: absolute; top: -20px; right: -8px; z-index: 2; animation: gameBlock 1.35s ease-in-out infinite; }
    .game-coin { position: absolute; z-index: 2; }
    .game-coin.c1 { top: -12px; left: 8%; animation: gameCoin 1.35s ease-in-out infinite; }
    .game-coin.c2 { top: 46%; right: -22px; animation: gameCoin 1.35s ease-in-out .3s infinite; }
    .game-coin.c3 { bottom: -22px; left: 34%; animation: gameCoin 1.35s ease-in-out .6s infinite; }

    @keyframes gameJump { 0%,100% { transform: translateY(0); } 38% { transform: translateY(-20px); } 56% { transform: translateY(-17px); } }
    @keyframes gameCoin { 0%,100% { transform: translateY(0); opacity: .95; } 42% { transform: translateY(-12px); opacity: 1; } }
    @keyframes gameBlock { 0%,35%,100% { transform: translateY(0); } 44%,58% { transform: translateY(-6px); } }

    /* ===== 统计块 ===== */
    .stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 32px; padding: 56px 0 0; border-top: 1px solid rgba(255,255,255,.08); margin-top: 56px; }
    .stat .num { font-family: var(--font-mono); font-size: 48px; font-weight: 500; line-height: 1; color: var(--color-neon-pulse); margin-bottom: 12px; }
    .stat .lbl { font-family: var(--font-mono); font-size: 9px; font-weight: 400; letter-spacing: .45px; text-transform: uppercase; color: rgba(255,255,255,.5); }

    /* ===== Logo Bar ===== */
    .logo-bar { padding: 24px 0 80px; }
    .logo-bar .bar-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: .45px; text-transform: uppercase; color: rgba(255,255,255,.5); text-align: center; margin-bottom: 28px; }
    .logo-tiles { display: grid; grid-template-columns: repeat(5,1fr); gap: 24px; }
    .logo-tile { background: var(--color-deep-abyss); border-radius: var(--radius-largecards); height: 120px; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.75); font-family: var(--font-mono); font-size: 15px; font-weight: 500; text-align: center; padding: 16px; }

    /* ===== Section 通用 ===== */
    section { padding: 40px 0; }
    .light-card { background: var(--color-deep-abyss); border: 1px solid var(--color-stone-border); border-radius: var(--radius-largecards); padding: 48px; color: var(--color-pure-white); }
    .light-card .eyebrow { color: var(--color-neon-pulse); }
    .light-card h2 { font-family: var(--font-mono); font-size: 40px; font-weight: 500; line-height: 1.2; color: var(--color-pure-white); margin-bottom: 16px; }
    .light-card .lead { font-size: 17px; line-height: 1.55; color: rgba(247, 250, 252, 0.65); max-width: 560px; }

    /* ===== 关于我 ===== */
    .about-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 48px; margin-top: 40px; align-items: center; }
    .about-copy p { font-size: 16px; line-height: 1.6; color: rgba(247, 250, 252, 0.85); margin-bottom: 16px; }
    .about-copy .muted { color: rgba(247, 250, 252, 0.6); }
    .about-visual { background: var(--color-charcoal); border: 1px solid var(--color-stone-border); border-radius: var(--radius-cards); padding: 32px; text-align: center; }
    .portrait { width: 96px; height: 96px; border-radius: 50%; background: var(--color-neon-pulse); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: var(--color-obsidian-shell); }
    .portrait svg { width: 44px; height: 44px; }
    .about-visual h4 { font-family: var(--font-mono); font-size: 20px; font-weight: 500; color: var(--color-pure-white); margin-bottom: 6px; }
    .about-visual p { font-size: 14px; color: rgba(247, 250, 252, 0.6); }
    .edu-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
    .edu-item { background: var(--color-charcoal); border: 1px solid var(--color-stone-border); border-radius: var(--radius-smallelements); padding: 20px 24px; }
    .edu-years { display: block; font-family: var(--font-mono); font-size: 13px; color: var(--color-neon-pulse); margin-bottom: 6px; }
    .edu-item strong { display: block; font-size: 17px; font-weight: 500; color: var(--color-pure-white); margin-bottom: 2px; }
    .edu-item .edu-major { font-size: 14px; color: rgba(247, 250, 252, 0.6); }

    /* ===== 技能 ===== */
    .skills-head { text-align: center; margin-bottom: 40px; }
    .skills-head h2 { font-family: var(--font-mono); font-size: 40px; font-weight: 500; line-height: 1.2; color: var(--color-pure-white); margin-bottom: 12px; }
    .skills-head p { font-size: 17px; color: rgba(255,255,255,.6); }
    .tabs { display: flex; justify-content: center; gap: 12px; margin-bottom: 32px; flex-wrap: wrap; }
    .tab { font-family: var(--font-sans); font-size: 16px; padding: 12px 24px; border-radius: var(--radius-tabs); background: transparent; border: none; color: var(--color-slate-text); cursor: pointer; transition: all .2s; }
    .tab:hover { color: var(--color-pure-white); }
    .tab.active { background: var(--color-neon-pulse); color: var(--color-obsidian-shell); }
    .skill-panel { display: none; }
    .skill-panel.active { display: block; }
    .skill-panel-inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: 40px; align-items: center; }
    .skill-panel .icon { width: 56px; height: 56px; color: var(--color-neon-pulse); margin-bottom: 20px; }
    .skill-panel h3 { font-family: var(--font-mono); font-size: 24px; font-weight: 500; color: var(--color-pure-white); margin-bottom: 12px; }
    .skill-panel p { font-size: 16px; line-height: 1.6; color: rgba(247, 250, 252, 0.65); }
    .skill-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .skill-list li { display: flex; align-items: center; gap: 12px; font-size: 16px; color: var(--color-pure-white); background: var(--color-charcoal); border: 1px solid var(--color-stone-border); border-radius: var(--radius-smallelements); padding: 14px 18px; }
    .skill-list li .check { width: 20px; height: 20px; border-radius: 50%; background: var(--color-neon-pulse); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--color-obsidian-shell); }
    .skill-list li .check svg { width: 12px; height: 12px; }

    /* ===== 文章与方法 ===== */
    .experience-head { text-align: center; margin-bottom: 48px; }
    .experience-head h2 { font-family: var(--font-mono); font-size: 40px; font-weight: 500; line-height: 1.2; color: var(--color-pure-white); margin-bottom: 12px; }
    .experience-head p { font-size: 17px; color: rgba(255,255,255,.6); }
    .timeline { position: relative; max-width: 980px; margin: 0 auto; padding-left: 36px; }
    .timeline::before { content: ''; position: absolute; left: 10px; top: 8px; bottom: 8px; width: 2px; background: rgba(255,255,255,.12); }
    .timeline-item { position: relative; background: var(--color-deep-abyss); border: 1px solid rgba(255,255,255,.06); border-radius: var(--radius-cards); padding: 28px 32px; margin-bottom: 24px; transition: transform .2s; }
    .timeline-item:hover { transform: translateY(-2px); border-color: rgba(126,247,200,.3); }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-item::before { content: ''; position: absolute; left: -32px; top: 30px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-neon-pulse); box-shadow: 0 0 0 4px rgba(126,247,200,.18); }
    .timeline-date { display: inline-block; font-family: var(--font-mono); font-size: 13px; color: var(--color-neon-pulse); letter-spacing: .04em; margin-bottom: 10px; }
    .timeline-role { font-family: var(--font-mono); font-size: 22px; font-weight: 500; color: var(--color-pure-white); margin-bottom: 4px; }
    .timeline-company { font-size: 15px; color: rgba(255,255,255,.55); margin-bottom: 18px; }
    .timeline-company .accent { color: var(--color-mint-whisper); }
    .timeline-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .timeline-list li { display: flex; gap: 10px; font-size: 15px; line-height: 1.6; color: rgba(255,255,255,.82); }
    .timeline-list li::before { content: ''; flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--color-neon-pulse); margin-top: 8px; }
    .article-item { display: block; text-decoration: none; color: inherit; }
    .article-meta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; color: rgba(247,250,252,.46); letter-spacing: .02em; margin-bottom: 10px; }
    .article-tag { color: var(--color-neon-pulse); background: rgba(126,247,200,.08); border: 1px solid rgba(126,247,200,.22); border-radius: 999px; padding: 3px 9px; }
    .article-title { font-family: var(--font-mono); font-size: 24px; font-weight: 500; line-height: 1.35; color: var(--color-pure-white); margin-bottom: 14px; }
    .article-summary { font-size: 16px; line-height: 1.75; color: rgba(247,250,252,.68); max-width: 820px; margin-bottom: 18px; }
    .read-more { font-family: var(--font-mono); font-size: 14px; color: var(--color-signal-yellow); }
    .method-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 32px; }
    .method-card { background: var(--color-charcoal); border: 1px solid rgba(255,255,255,.08); border-radius: var(--radius-cards); padding: 24px; }
    .method-card h3 { font-family: var(--font-mono); font-size: 18px; font-weight: 500; color: var(--color-neon-pulse); margin-bottom: 10px; }
    .method-card p { font-size: 15px; line-height: 1.65; color: rgba(247,250,252,.68); }

    /* ===== 联系 ===== */
    .contact { padding: 80px 0 96px; text-align: center; }
    .contact h2 { font-family: var(--font-mono); font-size: 48px; font-weight: 500; line-height: 1.12; color: var(--color-pure-white); margin-bottom: 20px; }
    .contact .contact-desc { font-size: 18px; color: rgba(255,255,255,.6); max-width: 480px; margin: 0 auto 40px; }
    .contact .cta-row { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }

    .contact-meta {
      margin-top: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      font-family: var(--font-mono);
      font-size: 13px;
      color: rgba(247, 250, 252, 0.55);
    }

    .contact-meta a { color: rgba(247, 250, 252, 0.7); text-decoration: none; transition: color .2s; }
    .contact-meta a:hover { color: var(--color-neon-pulse); }
    .contact-meta .sep { color: rgba(247, 250, 252, 0.25); }

    /* ===== 页脚 ===== */
    footer { border-top: 1px solid rgba(255,255,255,.08); padding: 32px 0; }
    .footer-inner { max-width: var(--page-max-width); margin: 0 auto; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .footer-inner p { font-size: 14px; color: rgba(255,255,255,.5); }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a { font-size: 14px; color: rgba(255,255,255,.6); text-decoration: none; }
    .footer-links a:hover { color: var(--color-neon-pulse); }

    /* ===== 响应式 ===== */
    @media (max-width: 900px) {
      .hero { padding: 64px 0; }
      .hero-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 44px; }
      .illustration { min-height: auto; margin-top: 24px; }
      .stats-row { grid-template-columns: repeat(2,1fr); }
      .logo-tiles { grid-template-columns: repeat(3,1fr); }
      .about-grid { grid-template-columns: 1fr; }
      .edu-row { grid-template-columns: 1fr; }
      .skill-panel-inner { grid-template-columns: 1fr; }
      .method-grid { grid-template-columns: 1fr; }
      .nav-links { display: none; }
      .light-card { padding: 32px 24px; }
      .light-card h2, .skills-head h2, .experience-head h2 { font-size: 32px; }
      .contact h2 { font-size: 36px; }
      .timeline { padding-left: 28px; }
      .timeline::before { left: 8px; }
      .timeline-item::before { left: -26px; width: 12px; height: 12px; }
    }
    @media (max-width: 560px) {
      .container { padding: 0 20px; }
      .hero h1 { font-size: 36px; }
      .mini-grid { width: 100%; max-width: 340px; }
      .game-char, .game-block, .game-coin { display: none; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .logo-tiles { grid-template-columns: repeat(2,1fr); }
      .footer-inner { flex-direction: column; text-align: center; }
      .announcement { padding: 10px 40px 10px 16px; font-size: 13px; }
      .timeline-item { padding: 24px 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .game-char, .game-block, .game-coin, .mini-card, .mini-grid { animation: none; }
    }
  </style>
</head>
